RewriteEngine On
RewriteBase /OnlineLearningPlatform/

DirectoryIndex index.php index.html

# Pass through real files only (NOT directories — the project root is a directory
# and would otherwise stop rewriting and show Apache's folder listing)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Let these folders handle their own requests
RewriteRule ^(api|backend|uploads|images|files|frontend)/ - [L]

# Everything else → Vite production build
RewriteRule ^(.*)$ frontend/dist/$1 [L]
